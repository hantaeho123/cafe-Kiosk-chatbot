# 이 파일을 .env 로 복사한 뒤 키를 넣는다. .env 는 git 에 올라가지 않는다.
OPENAI_API_KEY=sk-...

# 대화 모델은 render.yaml 과 함께 바꾼다. 나머지는 바꾸고 싶을 때만 주석을 푼다 (적힌 값이 기본값).
OPENAI_CHAT_MODEL=gpt-6-luna                # 대화 모델 (render.yaml 과 같은 값으로 맞춘다)
# OPENAI_EMBED_MODEL=text-embedding-3-small # 임베딩 모델 (바꾸면 인덱스를 다시 만든다)
# OPENAI_TEMPERATURE=0.3                    # 기본은 보내지 않음. 추론 모델(gpt-5 이후)에는 넣지 않는다
# RAG_TOP_K=6                               # 한 번에 찾아 올 문서 수
# RAG_MIN_SCORE=0                           # 이 유사도보다 낮은 문서는 버린다 (0 = 끔)
# USE_MODERATION=true                       # 입력을 OpenAI Moderation 으로 먼저 검사
# PORT=8000

# 공개 주소로 올릴 때
# ACCESS_PASSWORD=                          # 넣으면 키오스크와 직원 화면 모두 브라우저가 비밀번호를 묻는다 (아이디는 아무거나)
# CHAT_LIMIT_PER_SESSION=40                 # 손님 한 명이 10분 동안 보낼 수 있는 메시지 수 (0 = 끔)
# CHAT_LIMIT_PER_HOUR=600                   # 서버 전체가 1시간 동안 받는 메시지 수 (0 = 끔)
# IDLE_SECONDS=120                          # 조작이 없으면 "시간 연장" 안내를 띄우기까지의 시간(초). 0 이면 끈다
